<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>EntregaYa Integration</label>
    <description
  >BR-04: only the EntregaYa integration user may send shipment status updates (Apex REST /entregaya/v1/status-updates).</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>EntregaYaStatusResource</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApexRestServices</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
</PermissionSet>
