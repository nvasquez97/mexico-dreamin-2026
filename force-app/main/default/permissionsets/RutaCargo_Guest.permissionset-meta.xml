<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>RutaCargo site guest: only the Apex classes of the public pages and the EntregaYa principal for the proof of delivery. No object permissions.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>RutaCargo Guest</label>
    <classAccesses>
        <apexClass>CustomerAuthController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>DeliveryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PublicTrackingController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>EntregaYa-EntregaYaPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
</PermissionSet>
