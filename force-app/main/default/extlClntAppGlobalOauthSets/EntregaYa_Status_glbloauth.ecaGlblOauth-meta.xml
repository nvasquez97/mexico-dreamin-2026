<?xml version="1.0" encoding="UTF-8"?>
<!-- AC-004.6 (P4, P5): client credentials flow on; every other flow off.
     consumerKey and consumerSecret are never written here (they stay in the org,
     the owner hands them to EntregaYa, B4); no rotation on deploy.
     The platform requires a callback URL even for client credentials: it is a
     placeholder no flow uses (PKCE and the secret are required, users must be
     pre-authorized, and the only pre-authorized user is API only). -->
<ExtlClntAppGlobalOauthSettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <callbackUrl>https://localhost/entregaya/no-callback</callbackUrl>
    <externalClientApplication>EntregaYa_Status</externalClientApplication>
    <isClientCredentialsFlowEnabled>true</isClientCredentialsFlowEnabled>
    <isCodeCredFlowEnabled>false</isCodeCredFlowEnabled>
    <isConsumerSecretOptional>false</isConsumerSecretOptional>
    <isDeviceFlowEnabled>false</isDeviceFlowEnabled>
    <isIntrospectAllTokens>false</isIntrospectAllTokens>
    <isNamedUserJwtEnabled>false</isNamedUserJwtEnabled>
    <isPkceRequired>true</isPkceRequired>
    <isRefreshTokenRotationEnabled>false</isRefreshTokenRotationEnabled>
    <isSecretRequiredForRefreshToken>true</isSecretRequiredForRefreshToken>
    <isSecretRequiredForTokenExchange>true</isSecretRequiredForTokenExchange>
    <isTokenExchangeEnabled>false</isTokenExchangeEnabled>
    <label>EntregaYa Status Global OAuth</label>
    <shouldRotateConsumerKey>false</shouldRotateConsumerKey>
    <shouldRotateConsumerSecret>false</shouldRotateConsumerSecret>
</ExtlClntAppGlobalOauthSettings>
