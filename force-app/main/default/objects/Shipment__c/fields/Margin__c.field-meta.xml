<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Margin__c</fullName>
    <label>Margin</label>
    <description>Shipment margin: (Price - Carrier Cost) / Price. Internal, never shown on the site (BR-03).</description>
    <trackHistory>false</trackHistory>
    <formula>IF(Price__c &gt; 0, (Price__c - BLANKVALUE(Carrier_Cost__c, 0)) / Price__c, NULL)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <type>Percent</type>
    <unique>false</unique>
</CustomField>
