<?xml version="1.0" encoding="UTF-8"?>
<!-- SECURITY-JUSTIFICATION: E11 - the platform refuses the site guest's callout through an External Credential unless the guest gets Read on UserExternalCredential, an object permission the project rule forbids, so this is a legacy password Named Credential (P2 prefers External Credentials) with merge fields allowed in headers. Scope: the Authorization header of ProofOfDeliveryService (Bearer {!$Credential.Password}, a constant, never user input); merge fields are not allowed in the body. Compensating control: the API key is entered by hand by the owner in Setup as the password and is never in the repository; no guest permission set or object permission; the proof id is validated and URL-encoded before the callout. (pending owner approval, 2026-11-17) -->
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <description>EntregaYa proof API (req-002-003 S3, E11). Placeholder URL and no password until the owner enters the real base URL and the rotated API key (as the password) in Setup (README, E6). Never in the repository.</description>
    <endpoint>https://entregaya.invalid</endpoint>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>EntregaYa API</label>
    <namedCredentialType>Legacy</namedCredentialType>
    <principalType>NamedUser</principalType>
    <protocol>Password</protocol>
    <username>rutacargo</username>
</NamedCredential>
